mixin yt-video(url, urlPoster, props)

  //- Принимает:
  //-		id: ''							{string}
  //-   props {
  //-     mods: ''          {array}  - модификаторы блока

  if typeof (props) === 'undefined'
    - props = {};

  - let allMods = '';
  if typeof (props.mods) !== 'undefined' && props.mods
    each mods, index in props.mods
      - allMods += index ? ' ': '';
      - allMods += 'yt-video--' + mods;

  .yt-video(class = allMods)
    a(class="yt-video__link" href=url)
      if typeof (urlPoster) !== 'undefined' && urlPoster
        picture
          img(class="yt-video__media" src=urlPoster alt="")