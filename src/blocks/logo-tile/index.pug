.logo-tile
	each item, i in dataClients
		.logo-tile__item
			.logo-tile__inner
				img(src=item.image)
				if (item.link)
					a.logo-tile__info(href=item.link)
						.logo-tile__title !{item.title}
						p.logo-tile__description !{item.description}
				else
					.logo-tile__info
						.logo-tile__title !{item.title}
						p.logo-tile__description !{item.description}