mixin multiselect(props)

  //- Принимает:
  //-   props {
  //-     mods: ''          {array}  - модификаторы блока

  if typeof (props) === 'undefined'
    - props = {};

  - let allMods = '';
  - let multiple = true;
  if typeof (props.mods) !== 'undefined' && props.mods
    each mods, index in props.mods
      - allMods += index ? ' ': '';
      - allMods += 'multiselect--' + mods;

  if typeof (props.type) !== 'undefined' && props.type
    - multiple = props.type === 'checkbox';

  .multiselect(class = allMods)&attributes(attributes)
    button.multiselect__toggle
      .multiselect__placeholder Выберите
    .multiselect__dropdown
      .multiselect__dropdown-inner
        .multiselect__item.multiselect__checked-all
          +field-checkbox({
            title: 'Выбрать всё',
            multiple: multiple,
            mods: ['primary'],
            attrs: {
                class: 'multiselect__input multiselect__all',
                name: 'test'
            }
          })
        .multiselect__item
          +field-checkbox({
              title: 'Пункт 1',
