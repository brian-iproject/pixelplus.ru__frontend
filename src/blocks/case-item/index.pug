mixin case-item(data, props)

    //- Принимает:
    //-   data {
    //-     title:            {string} - имя
    //-     post:             {string} - должность
    //-     image:            {string} - фото
    //-   props {
    //-     mods: ''          {array}  - модификаторы блока

    if typeof (props) === 'undefined'
        - props = {};

    - let allMods = '';
    if typeof (props.mods) !== 'undefined' && props.mods
        each mods, index in props.mods
            - allMods += index ? ' ': '';
            - allMods += 'case-item--' + mods;

    .case-item(class = allMods)&attributes(attributes)
        .case-item__image
            img(src="/images/blocks/case-item/askona-prev.jpg")
            //if (data.image)
            //    img(src=data.image)
            //else
            //    svg(width="52" height="55" viewBox="0 0 52 55" fill="none" xmlns="http://www.w3.org/2000/svg")
            //        path(fill-rule="evenodd" clip-rule="evenodd" d="M26.9024 0H16.6138C14.2424 0 11.9093 1.95062 11.3739 4.32197L8.96427 14.8401C8.88778 15.146 9.11726 15.4903 9.46149 15.4903H23.6131C23.8426 15.4903 24.0721 15.3373 24.1103 15.0695L27.3996 0.650208C27.5143 0.344227 27.2466 0 26.9024 0ZM21.4712 24.0195H7.31963C7.09014 24.0195 6.86066 24.1725 6.82241 24.4402L0.0143428 54.3498C-0.0239048 54.5028 0.0143432 54.6558 0.129086 54.8088C0.243829 54.9235 0.358571 55 0.549809 55H10.0735C12.8273 55 15.6576 52.7434 16.2696 49.9896L22.0067 24.7079C22.0449 24.5549 22.0067 24.402 21.892 24.249C21.7772 24.096 21.6242 24.0195 21.4712 24.0195ZM45.7202 24.0195L31.5686 23.9812C31.3391 23.9812 31.1096 24.1342 31.0714 24.4019L27.7438 38.8595C27.7056 39.0125 27.7438 39.1655 27.8586 39.3185C27.9733 39.4332 28.0881 39.5097 28.2793 39.5097H38.4149C40.7863 39.5097 43.2723 37.5974 43.8461 35.2643L46.2939 24.7079C46.3321 24.5549 46.2939 24.402 46.1792 24.249C46.0262 24.096 45.9114 24.0195 45.7202 24.0195ZM47.6708 0H37.0762C36.8467 0 36.6173 0.15299 36.579 0.420723L33.2132 14.8783C33.175 15.0313 33.2132 15.1843 33.328 15.3373C33.4427 15.452 33.5575 15.5285 33.7487 15.5285H47.9768C48.2063 15.5285 48.4358 15.3755 48.474 15.1078L50.9983 4.32197C51.5338 1.91238 50.0422 0 47.6708 0Z" fill="#CC0000")
            .case-item__tags
                span E-commerce
                span Интернет-магазин
                span Интернет-магазин

        .case-item__info

            .case-item__badge-wrapper
                .case-item__awards
                    +award-flag({
                        icon: '<svg width="31" height="32" viewBox="0 0 31 32" fill="none" xmlns="http://www.w3.org/2000/svg">\n' +
                                '<path d="M11.6541 11.6541L15.6165 0L19.3459 11.6541H31L22.1429 18.6466L26.1053 31.2331L15.6165 23.5414L5.59399 31.2331L9.09023 19.812H11.6541V15.8496H7.69173V19.3459H4.42857V15.8496H7.69173V11.6541H11.6541Z" fill="#CAB66A"/>\n' +
                                '<path d="M0 14.6842V11.6541H2.79699V14.6842H0Z" fill="#CAB66A"/>\n' +
                                '<rect x="11.6541" y="11.6543" width="3.72932" height="4.19549" fill="white"/>\n' +
                                '<rect x="11.6541" y="19.5791" width="3.72932" height="4.19549" fill="white"/>\n' +
                                '</svg>\n',
                        info: 'Номинант конкурса«Рейтинг Рунета» 2018 (Промышленность и оборудование)'
                    })
                    +award-flag({
                        icon: '<svg width="27" height="30" viewBox="0 0 27 30" fill="none" xmlns="http://www.w3.org/2000/svg">\n' +
                                '<path d="M4.49053 29.2854L1.78726e-06 19.0634L11.0063 1.9244e-06L27 9.23403L16.0048 28.2783L4.49053 29.2854Z" fill="#CAB66A"/>\n' +
                                '<circle cx="8.48742" cy="22.2159" r="3.15245" fill="white"/>\n' +
                                '</svg>\n',
                        info: 'Номинант конкурса«Рейтинг Рунета» 2018 (Промышленность и оборудование)'
                    })
                .case-item__badge тариф «Депозитый»



            .case-item__logo
                img(src="/assets/askona-logo.png")
            .case-item__indicators
                div
                    b +18%
                    span переходов  в корзину
                div
                    b +325%
                    span трафик на сайт
                div
                    b +167%
                    span число заявок  и звонков

            .case-item__illustration-result
                img(src="blocks/case-full/images/psb-graph.png" width="224" height="164" alt="")

            .case-item__description

                p Поисковый аудит можно сравнить с базовым медицинским обследованием перед началом лечения. Вам требуется осмотр специалиста (врача) и сдача анализов для выявления симптомов и формирования дальнейшего плана улучшения здоровья. В роли здоровья выступает целевой трафик и заказы из поисковых систем, в роли врача — SEO-специалист, а различные проверки, которые проводятся с сайтом — выполняют роль анализов.
                if typeof (props.mods) !== 'undefined' && props.mods && props.mods.includes('columns')
                    .d-grid.container
                        +text-icon({
                            svgId: 'problem',
                            text: '<span class="-fw-sb">Проблема</span><p class="-fs-small container container--xxs">В шапке сайта отсутствовали важные элементы: кнопка обратного звонка, иконки избранного, сравнения и корзины, что мешало пользователям быстро взаимодействовать с сайтом.</p>'
                        }, {
                            iconMods: ['md', 'primary']
                        }).-c-primary
                        +text-icon({
                            svgId: 'solution',
                            text: '<span class="-fw-sb">Решение</span><p class="-fs-small container container--xxs">Команда «Пиксель Плюс» разработала  и внедрила адаптивные макеты шапки.  С помощью дизайна акцентировали внимание  на ключевых функциях и сделали интерфейс более удобным и понятным.</p>'
                        }, {
                            iconMods: ['md', 'primary']
                        })
                else
                    .d-grid.d-grid--sm-2.container
                        +text-icon({
                            svgId: 'account',
                            text: '<span class="-fw-sb">Проблема</span><p class="-fs-small container container--xxs">В шапке сайта отсутствовали важные элементы: кнопка обратного звонка, иконки избранного, сравнения и корзины, что мешало пользователям быстро взаимодействовать с сайтом.</p>'
                        }, {
                            iconMods: ['md', 'primary']
                        }).-c-primary
                        +text-icon({
                            svgId: 'account',
                            text: '<span class="-fw-sb">Решение</span><p class="-fs-small container container--xxs">Команда «Пиксель Плюс» разработала  и внедрила адаптивные макеты шапки.  С помощью дизайна акцентировали внимание  на ключевых функциях и сделали интерфейс более удобным и понятным.</p>'
                        }, {
                            iconMods: ['md', 'primary']
                        })

            .case-item__footer
                .case-item__manager
                    +author({
                        src: 'assets/lunin.jpg',
                        title: 'Анастасия',
                        description: 'Руководитель проекта'
                    })
                .case-item__button
                    a.button.button--primary Подробнее о кейсе