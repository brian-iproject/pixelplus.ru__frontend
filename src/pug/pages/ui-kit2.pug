      //- ══════════════════════════════════════════
      //- DONUT-CHART
      //- ══════════════════════════════════════════
      section#donut-chart.uk2-section
        h2 Donut-chart
        p.uk2-desc Круговая диаграмма: SVG-кольцо и легенда — штатная #[code .table.table--bg-lines] с квадратиками цвета #[code .donut-chart__swatch]. От 768px — две колонки по центру, до — кольцо сверху (до 240px). Цвет доли — #[code --donut-color] на сегменте и строке, значение — палитра блока #[code --donut-chart-1…9] по порядку (первая — #[code --color-primary], девятая серая — «Другое»). В центре — значение и подпись самой большой доли. Класс #[code DonutChart]: наведение и фокус на сегмент или строку приглушают остальные доли, подсвечивают строку и показывают долю в центре; кольцо ниже экрана прорисовывается при прокрутке (без анимации при #[code prefers-reduced-motion]). Без JS всё видно. На сайте разметку и геометрию кольца считает шаблон блока my_donut. Используется в детальной кейса.

        .uk2-preview
          .container.container--xl
            include ../../blocks/donut-chart/index

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/donut-chart/index

            // Сегмент: r=80 в viewBox 200×200, длина окружности 502,65; stroke-dasharray «длина−2 остаток»,
            // stroke-dashoffset — минус (начало + 1); --donut-start и --donut-size — доли для прорисовки
            circle.donut-chart__segment(data-donut-index='1' … style='--donut-color: var(--donut-chart-2); --donut-start: .676; --donut-size: .241')

      //- ══════════════════════════════════════════
      //- BAR-CHART
      //- ══════════════════════════════════════════
      section#bar-chart.uk2-section
        h2 Bar-chart
        p.uk2-desc Столбчатый график: динамика по периодам. Столбцы — HTML, не SVG, поэтому подписи на телефоне не сжимаются. Шкала слева — 4–5 линий на «круглых» значениях, под столбцами — периоды. Первый столбец — база сравнения, серый (#[code .bar-chart__col--base]), остальные — #[code --bar-chart-color] (по умолчанию #[code --color-green]). Высота столбца — #[code --bar-value], линия сетки — #[code --bar-tick] (доли верхней линии шкалы). Над первым и последним столбцом — значения. #[code .bar-chart--many-sm] (больше 8 периодов) — до 768px подписи через одну, #[code .bar-chart--many] (больше 20) — через одну везде; много периодов на телефоне — прокрутка внутри графика (#[code --bar-chart-count] задаёт минимальную ширину). Таблица значений #[code .bar-chart__table] — только для скринридеров. Класс #[code BarChart]: наведение и фокус на столбец приглушают остальные и показывают подсказку (период, значение, пояснение из #[code data-bar-note]); график ниже экрана вырастает при прокрутке (без анимации при #[code prefers-reduced-motion]). Без JS всё видно. На сайте разметку и шкалу считает шаблон блока my_bar-chart. Используется в детальной кейса.

        .uk2-preview
          .container.container--xl
            include ../../blocks/bar-chart/index

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/bar-chart/index

            // Колонка: --bar-value — высота долей верхней линии шкалы, --bar-order — задержка роста;
            // подсказка — из data-bar-label, data-bar-value и data-bar-note (изменение к базе или исходное значение)
            .bar-chart__col(data-bar-index='1' data-bar-label='авг' data-bar-value='104%' data-bar-note='12 900 визитов' style='--bar-value: .3468; --bar-order: 1')

