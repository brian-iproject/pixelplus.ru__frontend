              +multiselect({})('data-ms-placeholder="Все услуги" data-ms-search-placeholder="Поиск"')
            div
              p.-fw-sb Radio-режим:
              +multiselect({type: 'radio'})('data-ms-placeholder="Все тематики" data-ms-type="radio" data-ms-all-text="Все тематики"')

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/multiselect/index
            // JS инициализируется через MultiSelectCheckbox.js

            // Checkbox-режим (по умолчанию)
            +multiselect({})(
              data-ms-placeholder='Все услуги'
              data-ms-search-placeholder='Поиск по услугам'
            )

            // Radio-режим
            +multiselect({type: 'radio'})(
              data-ms-placeholder='Все тематики'
              data-ms-type='radio'
              data-ms-all-text='Все тематики'
            )

            // Скрытый input (для страниц-фильтров)
            +multiselect({mods: ['hide-input1'], type: 'radio'})(
              data-ms-placeholder='Тематика'
              data-ms-type='radio'
            )
