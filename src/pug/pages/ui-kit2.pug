      section#multiselect.uk2-section
        h2 Multiselect
        p.uk2-desc Выпадающий список с мультивыбором (checkbox) или одиночным выбором (radio). Управляется #[code MultiSelectCheckbox.js]. Миксин: #[code +multiselect(props)].

        table.uk2-params
          thead
            tr
              th Параметр / Атрибут
              th Тип
              th Описание
          tbody
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока. #[code hide-input1] — скрывает input для фильтров
            tr
