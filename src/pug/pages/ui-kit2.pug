          .uk2-row
            +field-checkbox({title: 'Базовый', multiple: true})
            +field-checkbox({title: 'Primary', multiple: true, mods: ['primary']})
            +field-checkbox({title: 'Отключён', multiple: true, attrs: {disabled: true}})
          p.-fw-sb.uk2-gap Радиокнопки:
