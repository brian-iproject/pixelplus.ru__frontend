extends ../layout.pug

block meta
  title UI-KIT 2 — Документация блоков
  meta(name='description', content='')

block head
  style.
    .uk2 { padding-bottom: 60px }
    .uk2-toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 40px; padding: 20px 24px; background: var(--color-gray--lighter); border-radius: 8px; }
    .uk2-toc a { background: #fff; border: 1px solid var(--color-gray--lighten); border-radius: 20px; padding: 5px 14px; font-size: 13px; text-decoration: none; color: var(--color-gray--darken); transition: border-color .15s, color .15s; }
    .uk2-toc a:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .uk2-section { padding: 40px 0; border-bottom: 2px solid var(--color-gray--lighten); }
    .uk2-section:last-child { border-bottom: none; }
    .uk2-section > h2 { margin-bottom: 4px; }
    .uk2-desc { color: var(--color-gray--dark); margin-bottom: 16px; }
    .uk2-params { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
    .uk2-params th { background: var(--color-gray--lighten); text-align: left; padding: 8px 12px; font-weight: 600; }
    .uk2-params td { padding: 8px 12px; border-top: 1px solid var(--color-gray--lighten); vertical-align: top; font-size: 13px; }
    .uk2-params code { background: var(--color-gray--lighten); padding: 1px 5px; border-radius: 3px; font-size: 11px; font-family: monospace; }
    .uk2-preview { background: var(--color-gray--lighter); border-radius: 8px; padding: 24px; margin-bottom: 12px; }
    .uk2-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
    details.uk2-details summary { cursor: pointer; display: inline-flex; align-items: center; gap: 6px; color: var(--color-primary); font-weight: 600; font-size: 14px; padding: 6px 0; user-select: none; list-style: none; }
    details.uk2-details summary::before { content: '\25B6'; font-size: 9px; transition: transform .2s; display: inline-block; }
    details.uk2-details[open] summary::before { transform: rotate(90deg); }
    details.uk2-details summary::-webkit-details-marker { display: none; }
    .uk2-code { background: #1a1a2e; color: #e2e8f0; border-radius: 6px; padding: 16px 20px; overflow-x: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; line-height: 1.7; margin-top: 8px; white-space: pre; }
    .uk2-gap { margin-top: 16px; }

block content
  .wide-block
    .page-container.uk2

      h1 UI-KIT 2 — Документация компонентов
      p.subtitle Справочник по блокам проекта: параметры, модификаторы и примеры подключения.

      nav.uk2-toc(aria-label='Оглавление')
        a(href='#buttons') Кнопки
        a(href='#tags') Теги
        a(href='#icons') Иконки
        a(href='#alerts') Алерты
        a(href='#timing') Timing
        a(href='#author') Author
        a(href='#text-icon') Text-icon
        a(href='#employee-item') Employee-item
        a(href='#employee-wide') Employee-wide
        a(href='#competence') Competence
        a(href='#logo-item') Logo-item
        a(href='#discount-tile') Discount-tile
        a(href='#award-flag') Award-flag
        a(href='#achievements-wide') Achievements-wide
        a(href='#case-small') Case-small
        a(href='#field-checkbox') Field-checkbox
        a(href='#field-range') Field-range
        a(href='#field-file') Field-file
        a(href='#multiselect') Multiselect

      //- ══════════════════════════════════════════
      //- КНОПКИ
      //- ══════════════════════════════════════════
      section#buttons.uk2-section
        h2 Кнопки
        p.uk2-desc Базовый элемент интерфейса. Используется тег #[code a], #[code button] или #[code div] с CSS-классами. Миксин не требуется — чистые классы.

        table.uk2-params
          thead
            tr
              th Класс-модификатор
              th Описание
          tbody
            tr
              td (базовый #[code .button])
              td Стандартная кнопка без фона
            tr
              td: code .button--primary
              td Основной вариант (красный фон)
            tr
              td: code .button--outline
              td Контурная, прозрачный фон
            tr
              td: code .button--white
              td Белая (для тёмного фона)
            tr
              td: code .button--small
              td Уменьшенный размер
            tr
              td: code .button--large
              td Увеличенный размер
            tr
              td: code .button--full
              td Ширина 100%
            tr
              td: code .button--icon
              td Кнопка-иконка без текста

        .uk2-preview
          .uk2-row
            a.button Кнопка
            a.button.button--primary Основная
            a.button.button--outline Контурная
            a.button.button--small Маленькая
            a.button.button--large Большая
            button.button.button--primary(disabled) Отключена

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // Базовые варианты
            a.button Кнопка
            a.button.button--primary Основная
            a.button.button--outline Контурная

            // Размеры
            a.button.button--small Маленькая
            a.button.button--large Большая

            // Ширина 100%
            a.button.button--primary.button--full Широкая кнопка

            // С иконкой (потребует +icon из mixins)
            a.button.button--primary
              +icon({id: 'account', mods: ['sm']})
              | Текст кнопки

            // Отключена
            button.button.button--primary(disabled) Отправить


      //- ══════════════════════════════════════════
      //- ТЕГИ
      //- ══════════════════════════════════════════
      section#tags.uk2-section
        h2 Теги
        p.uk2-desc Компонент-метка для категорий, фильтров и ключевых слов. Подключается через миксин #[code +tag(props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code props.tag
              td string
              td HTML-тег элемента. По умолчанию #[code button]
            tr
              td: code props.title
              td string
              td Текст внутри тега
            tr
              td: code props.mods
              td string[]
              td Массив модификаторов: #[code active], #[code primary]

        .uk2-preview
          .uk2-row
            +tag({title: 'SEO-продвижение'})
            +tag({title: 'Разработка'})
            +tag({title: 'Активный', mods: ['active']})
            +tag({title: 'Primary', mods: ['primary']})
            +tag({tag: 'span', title: 'Span-тег'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/tag/index

            // Базовый
            +tag({title: 'SEO-продвижение'})

            // Активное состояние
            +tag({title: 'Активный', mods: ['active']})

            // Primary
            +tag({title: 'Primary', mods: ['primary']})

            // Как span
            +tag({tag: 'span', title: 'Ссылка'})

            // Несколько в ряд
            .flex.flex--wrap
              +tag({title: 'SEO'})
              +tag({title: 'Контекст'})
              +tag({title: 'Дизайн'})


      //- ══════════════════════════════════════════
      //- ИКОНКИ
      //- ══════════════════════════════════════════
      section#icons.uk2-section
        h2 Иконки
        p.uk2-desc SVG-иконки из спрайта #[code src/icons/sprite.svg]. Подключаются через миксин #[code +icon(props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code props.id
              td string
              td ID иконки в SVG-спрайте (без символа #[code #])
            tr
              td: code props.mods
              td string[]
              td Размер: #[code sm], #[code md], #[code lg]. Цвет: #[code primary], #[code white], #[code gray]

        .uk2-preview
          .uk2-row(style='align-items:center')
            +icon({id: 'account', mods: ['sm']})
            +icon({id: 'account', mods: ['md']})
            +icon({id: 'account', mods: ['lg']})
            +icon({id: 'account', mods: ['md', 'primary']})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/icon/index

            // Маленькая
            +icon({id: 'account', mods: ['sm']})

            // Средняя
            +icon({id: 'account', mods: ['md']})

            // Большая
            +icon({id: 'account', mods: ['lg']})

            // С цветом
            +icon({id: 'account', mods: ['md', 'primary']})

            // С дополнительными атрибутами
            +icon({id: 'account', mods: ['md']})(aria-hidden='true')


      //- ══════════════════════════════════════════
      //- АЛЕРТЫ
      //- ══════════════════════════════════════════
      section#alerts.uk2-section
        h2 Алерты
        p.uk2-desc Информационные плашки четырёх типов. Чистые CSS-классы, миксин не нужен.

        table.uk2-params
          thead
            tr
              th Класс
              th Описание
          tbody
            tr
              td: code .alert.alert--success
              td Успех (зелёный)
            tr
              td: code .alert.alert--info
              td Информация (синий)
            tr
              td: code .alert.alert--error
              td Ошибка (красный)
            tr
              td: code .alert.alert--warning
              td Предупреждение (жёлтый)
            tr
              td: code .alert--flex
              td Модификатор: иконка + текст в строку

        .uk2-preview
          .alert.alert--success Успешно сохранено
          .alert.alert--info Это информационное сообщение
          .alert.alert--error Произошла ошибка, попробуйте снова
          .alert.alert--warning Внимание: данные не сохранены

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // Простые варианты
            .alert.alert--success Успешно сохранено
            .alert.alert--info Информационное сообщение
            .alert.alert--error Произошла ошибка
            .alert.alert--warning Внимание

            // С иконкой (модификатор flex)
            .alert.alert--success.alert--flex
              svg(xmlns='http://www.w3.org/2000/svg' ...)
              | Текст алерта с иконкой слева


      //- ══════════════════════════════════════════
      //- TIMING
      //- ══════════════════════════════════════════
      section#timing.uk2-section
        h2 Timing
        p.uk2-desc Метка с продолжительностью или временным значением. Подключается через #[code +timing(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data
              td string
              td Текст (HTML-строка)
            tr
              td: code props.mods
              td string[]
              td Модификаторы: #[code gray], #[code primary]

        .uk2-preview
          .uk2-row
            +timing('3 месяца')
            +timing('15 минут', {mods: ['gray']})
            +timing('6 недель', {mods: ['primary']})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/timing/index

            // Базовый
            +timing('3 месяца')

            // Серый
            +timing('15 минут', {mods: ['gray']})

            // Primary
            +timing('6 недель', {mods: ['primary']})

            // С HTML
            +timing('от &lt;b&gt;2 недель&lt;/b&gt;')


      //- ══════════════════════════════════════════
      //- AUTHOR
      //- ══════════════════════════════════════════
      section#author.uk2-section
        h2 Author
        p.uk2-desc Карточка автора: аватар или инициалы + имя + должность. Используется в кейсах, статьях, отзывах. Миксин: #[code +author(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.src
              td string
              td Путь до фото. Если не указан — первая буква #[code data.title]
            tr
              td: code data.title
              td string
              td Имя
            tr
              td: code data.description
              td string
              td Должность или подпись
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока

        .uk2-preview
          .uk2-row
            +author({src: 'assets/lunin.jpg', title: 'Анастасия', description: 'Руководитель проекта'})
            +author({title: 'Дмитрий Севальнев', description: 'Генеральный директор'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/author/index

            // С фотографией
            +author({
              src: 'assets/photo.jpg',
              title: 'Анастасия',
              description: 'Руководитель проекта'
            })

            // Без фото — первая буква имени как аватар
            +author({
              title: 'Дмитрий Севальнев',
              description: 'Генеральный директор'
            })

            // С модификатором
            +author({title: 'Имя', description: 'Должность'}, {mods: ['small']})


      //- ══════════════════════════════════════════
      //- TEXT-ICON
      //- ══════════════════════════════════════════
      section#text-icon.uk2-section
        h2 Text-icon
        p.uk2-desc Горизонтальная компоновка «иконка + текст». Используется в списках преимуществ, описаниях услуг. Миксин: #[code +text-icon(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.svgId
              td string
              td ID иконки в SVG-спрайте
            tr
              td: code data.text
              td string
              td HTML-текст (принимает теги)
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока
            tr
              td: code props.iconMods
              td string[]
              td Модификаторы иконки: #[code sm], #[code md], #[code lg], #[code primary]
            tr
              td: code props.iconAttrs
              td object
              td Дополнительные атрибуты для SVG-элемента

        .uk2-preview
          .d-grid.d-grid--sm-2
            +text-icon({svgId: 'account', text: 'Опыт более 15 лет в разработке сайтов'})
            +text-icon({svgId: 'account', text: 'Команда из 50+ специалистов'}, {iconMods: ['md', 'primary']})
            +text-icon({svgId: 'account', text: 'Гарантия результата прописана в договоре'}, {iconMods: ['lg']})
            +text-icon({svgId: 'account', text: 'Прозрачная отчётность каждый месяц'}, {iconMods: ['md']})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/text-icon/index

            // Базовый (иконка md по умолчанию)
            +text-icon({
              svgId: 'account',
              text: 'Текст рядом с иконкой'
            })

            // Иконка с цветом
            +text-icon({
              svgId: 'account',
              text: 'Опыт более 15 лет'
            }, {
              iconMods: ['md', 'primary']
            })

            // HTML в тексте
            +text-icon({
              svgId: 'account',
              text: '&lt;strong&gt;Гарантия&lt;/strong&gt; результата прописана в договоре'
            })

            // Сетка из нескольких элементов
            .d-grid.d-grid--sm-2
              +text-icon({svgId: 'account', text: 'Преимущество 1'}, {iconMods: ['md', 'primary']})
              +text-icon({svgId: 'account', text: 'Преимущество 2'}, {iconMods: ['md', 'primary']})
              +text-icon({svgId: 'account', text: 'Преимущество 3'}, {iconMods: ['md', 'primary']})
              +text-icon({svgId: 'account', text: 'Преимущество 4'}, {iconMods: ['md', 'primary']})


      //- ══════════════════════════════════════════
      //- EMPLOYEE-ITEM
      //- ══════════════════════════════════════════
      section#employee-item.uk2-section
        h2 Employee-item
        p.uk2-desc Компактная карточка сотрудника. Используется в листингах команды. Миксин: #[code +employee-item(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.title
              td string
              td Имя сотрудника
            tr
              td: code data.post
              td string
              td Должность
            tr
              td: code data.image
              td string
              td Путь до фото. Без него — SVG-заглушка с логотипом
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока

        .uk2-preview
          .d-grid.d-grid--sm-2.d-grid--lg-3
            +employee-item({title: 'Дмитрий Севальнев', post: 'Генеральный директор'})
            +employee-item({title: 'Анастасия Лунина', post: 'Руководитель проекта', image: 'assets/lunin.jpg'})
            +employee-item({title: 'Алексей Павлов', post: 'Разработчик'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/employee-item/index

            // Без фото (SVG-заглушка)
            +employee-item({
              title: 'Дмитрий Севальнев',
              post: 'Генеральный директор'
            })

            // С фото
            +employee-item({
              title: 'Анастасия Лунина',
              post: 'Руководитель проекта',
              image: 'assets/photo.jpg'
            })

            // Сетка карточек
            .d-grid.d-grid--sm-2.d-grid--lg-3
              +employee-item({title: 'Имя 1', post: 'Должность 1'})
              +employee-item({title: 'Имя 2', post: 'Должность 2'})
              +employee-item({title: 'Имя 3', post: 'Должность 3'})


      //- ══════════════════════════════════════════
      //- EMPLOYEE-WIDE
      //- ══════════════════════════════════════════
      section#employee-wide.uk2-section
        h2 Employee-wide
        p.uk2-desc Расширенная карточка сотрудника: фото + имя + должность + описание. Миксин: #[code +employee-wide(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.title
              td string
              td Имя
            tr
              td: code data.post
              td string
              td Должность
            tr
              td: code data.imageWide
              td string
              td Путь до фото. Без него — SVG-заглушка
            tr
              td: code data.description
              td string
              td HTML-описание (биография, достижения)
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока
            tr
              td: code props.mirror
              td bool
              td #[code true] — фото справа, текст слева

        .uk2-preview
          +employee-wide({
            title: 'Дмитрий Севальнев',
            post: 'Генеральный директор',
            description: '<p>Основатель агентства «Пиксель Плюс». Более 15 лет в digital-маркетинге и веб-разработке. Под руководством Дмитрия реализовано более 500 проектов.</p>'
          })

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/employee-wide/index

            // Фото слева (по умолчанию)
            +employee-wide({
              title: 'Дмитрий Севальнев',
              post: 'Генеральный директор',
              imageWide: 'assets/photo.jpg',
              description: '&lt;p&gt;Текст биографии...&lt;/p&gt;'
            })

            // Фото справа (зеркально)
            +employee-wide({
              title: 'Анастасия',
              post: 'Руководитель проектов',
              imageWide: 'assets/photo2.jpg',
              description: '&lt;p&gt;Текст...&lt;/p&gt;'
            }, {
              mirror: true
            })


      //- ══════════════════════════════════════════
      //- COMPETENCE
      //- ══════════════════════════════════════════
      section#competence.uk2-section
        h2 Competence
        p.uk2-desc Карточка технологии или компетенции: логотип + название. Миксин: #[code +competence(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.src
              td string
              td Путь до логотипа технологии
            tr
              td: code data.title
              td string
              td Название технологии или компетенции
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока

        .uk2-preview
          .d-grid.d-grid--sm-3.d-grid--lg-4
            +competence({src: 'assets/bitrix.png', title: '1С-Битрикс'})
            +competence({src: 'assets/bitrix.png', title: 'WordPress'})
            +competence({src: 'assets/bitrix.png', title: 'Bitrix24'})
            +competence({src: 'assets/bitrix.png', title: 'Laravel'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/competence/index

            // Одиночный элемент
            +competence({
              src: 'images/logo-bitrix.png',
              title: '1С-Битрикс'
            })

            // Сетка компетенций
            .d-grid.d-grid--sm-3.d-grid--lg-4
