extends ../layout.pug

block meta
  title UI-KIT 2 — Документация блоков
  meta(name='description', content='')

block head
  style.
    .uk2 { padding-bottom: 60px }
    .uk2-toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 40px; padding: 20px 24px; background: var(--color-gray--lighter); border-radius: 8px; }
    .uk2-toc a { background: #fff; border: 1px solid var(--color-gray--lighten); border-radius: 20px; padding: 5px 14px; font-size: 13px; text-decoration: none; color: var(--color-gray--darken); transition: border-color .15s, color .15s; }
    .uk2-toc a:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .uk2-section { padding: 40px 0; border-bottom: 2px solid var(--color-gray--lighten); }
    .uk2-section:last-child { border-bottom: none; }
    .uk2-section > h2 { margin-bottom: 4px; }
    .uk2-desc { color: var(--color-gray--dark); margin-bottom: 16px; }
    .uk2-params { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
    .uk2-params th { background: var(--color-gray--lighten); text-align: left; padding: 8px 12px; font-weight: 600; }
    .uk2-params td { padding: 8px 12px; border-top: 1px solid var(--color-gray--lighten); vertical-align: top; font-size: 13px; }
    .uk2-params code { background: var(--color-gray--lighten); padding: 1px 5px; border-radius: 3px; font-size: 11px; font-family: monospace; }
    .uk2-preview { background: var(--color-gray--lighter); border-radius: 8px; padding: 24px; margin-bottom: 12px; }
    .uk2-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; }
    details.uk2-details summary { cursor: pointer; display: inline-flex; align-items: center; gap: 6px; color: var(--color-primary); font-weight: 600; font-size: 14px; padding: 6px 0; user-select: none; list-style: none; }
    details.uk2-details summary::before { content: '\25B6'; font-size: 9px; transition: transform .2s; display: inline-block; }
    details.uk2-details[open] summary::before { transform: rotate(90deg); }
    details.uk2-details summary::-webkit-details-marker { display: none; }
    .uk2-code { background: #1a1a2e; color: #e2e8f0; border-radius: 6px; padding: 16px 20px; overflow-x: auto; font-family: 'Consolas', 'Monaco', monospace; font-size: 13px; line-height: 1.7; margin-top: 8px; white-space: pre; }
    .uk2-gap { margin-top: 16px; }

block content
  .wide-block
    .page-container.uk2

      h1 UI-KIT 2 — Документация компонентов
      p.subtitle Справочник по блокам проекта: параметры, модификаторы и примеры подключения.

      nav.uk2-toc(aria-label='Оглавление')
        a(href='#buttons') Кнопки
        a(href='#tags') Теги
        a(href='#icons') Иконки
        a(href='#alerts') Алерты
        a(href='#timing') Timing
        a(href='#author') Author
        a(href='#review-quote') Review-quote
        a(href='#timeline') Timeline
        a(href='#statement') Statement
        a(href='#metric-card') Metric-card
        a(href='#compare-line') Compare-line
        a(href='#report-card') Report-card
        a(href='#donut-chart') Donut-chart
        a(href='#bar-chart') Bar-chart
        a(href='#award-badge') Award-badge
        a(href='#anchor-menu') Anchor-menu
        a(href='#accent') Accent
        a(href='#pretitle') Pretitle
        a(href='#text-icon') Text-icon
        a(href='#employee-item') Employee-item
        a(href='#employee-wide') Employee-wide
        a(href='#competence') Competence
        a(href='#logo-item') Logo-item
        a(href='#discount-tile') Discount-tile
        a(href='#award-flag') Award-flag
        a(href='#achievements-wide') Achievements-wide
        a(href='#case-small') Case-small
        a(href='#field-checkbox') Field-checkbox
        a(href='#field-range') Field-range
        a(href='#field-file') Field-file
        a(href='#multiselect') Multiselect

      //- ══════════════════════════════════════════
      //- КНОПКИ
      //- ══════════════════════════════════════════
      section#buttons.uk2-section
        h2 Кнопки
        p.uk2-desc Базовый элемент интерфейса. Используется тег #[code a], #[code button] или #[code div] с CSS-классами. Миксин не требуется — чистые классы.

        table.uk2-params
          thead
            tr
              th Класс-модификатор
              th Описание
          tbody
            tr
              td (базовый #[code .button])
              td Стандартная кнопка без фона
            tr
              td: code .button--primary
              td Основной вариант (красный фон)
            tr
              td: code .button--outline
              td Контурная, прозрачный фон
            tr
              td: code .button--white
              td Белая (для тёмного фона)
            tr
              td: code .button--small
              td Уменьшенный размер
            tr
              td: code .button--large
              td Увеличенный размер
            tr
              td: code .button--full
              td Ширина 100%
            tr
              td: code .button--icon
              td Кнопка-иконка без текста

        .uk2-preview
          .uk2-row
            a.button Кнопка
            a.button.button--primary Основная
            a.button.button--outline Контурная
            a.button.button--small Маленькая
            a.button.button--large Большая
            button.button.button--primary(disabled) Отключена

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // Базовые варианты
            a.button Кнопка
            a.button.button--primary Основная
            a.button.button--outline Контурная

            // Размеры
            a.button.button--small Маленькая
            a.button.button--large Большая

            // Ширина 100%
            a.button.button--primary.button--full Широкая кнопка

            // С иконкой (потребует +icon из mixins)
            a.button.button--primary
              +icon({id: 'account', mods: ['sm']})
              | Текст кнопки

            // Отключена
            button.button.button--primary(disabled) Отправить


      //- ══════════════════════════════════════════
      //- ТЕГИ
      //- ══════════════════════════════════════════
      section#tags.uk2-section
        h2 Теги
        p.uk2-desc Компонент-метка для категорий, фильтров и ключевых слов. Подключается через миксин #[code +tag(props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code props.tag
              td string
              td HTML-тег элемента. По умолчанию #[code button]
            tr
              td: code props.title
              td string
              td Текст внутри тега
            tr
              td: code props.mods
              td string[]
              td Массив модификаторов: #[code active], #[code primary]

        .uk2-preview
          .uk2-row
            +tag({title: 'SEO-продвижение'})
            +tag({title: 'Разработка'})
            +tag({title: 'Активный', mods: ['active']})
            +tag({title: 'Primary', mods: ['primary']})
            +tag({tag: 'span', title: 'Span-тег'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/tag/index

            // Базовый
            +tag({title: 'SEO-продвижение'})

            // Активное состояние
            +tag({title: 'Активный', mods: ['active']})

            // Primary
            +tag({title: 'Primary', mods: ['primary']})

            // Как span
            +tag({tag: 'span', title: 'Ссылка'})

            // Несколько в ряд
            .flex.flex--wrap
              +tag({title: 'SEO'})
              +tag({title: 'Контекст'})
              +tag({title: 'Дизайн'})


      //- ══════════════════════════════════════════
      //- ИКОНКИ
      //- ══════════════════════════════════════════
      section#icons.uk2-section
        h2 Иконки
        p.uk2-desc SVG-иконки из спрайта #[code src/icons/sprite.svg]. Подключаются через миксин #[code +icon(props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code props.id
              td string
              td ID иконки в SVG-спрайте (без символа #[code #])
            tr
              td: code props.mods
              td string[]
              td Размер: #[code sm], #[code md], #[code lg]. Цвет: #[code primary], #[code white], #[code gray]

        .uk2-preview
          .uk2-row(style='align-items:center')
            +icon({id: 'account', mods: ['sm']})
            +icon({id: 'account', mods: ['md']})
            +icon({id: 'account', mods: ['lg']})
            +icon({id: 'account', mods: ['md', 'primary']})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/icon/index

            // Маленькая
            +icon({id: 'account', mods: ['sm']})

            // Средняя
            +icon({id: 'account', mods: ['md']})

            // Большая
            +icon({id: 'account', mods: ['lg']})

            // С цветом
            +icon({id: 'account', mods: ['md', 'primary']})

            // С дополнительными атрибутами
            +icon({id: 'account', mods: ['md']})(aria-hidden='true')


      //- ══════════════════════════════════════════
      //- АЛЕРТЫ
      //- ══════════════════════════════════════════
      section#alerts.uk2-section
        h2 Алерты
        p.uk2-desc Информационные плашки четырёх типов. Чистые CSS-классы, миксин не нужен.

        table.uk2-params
          thead
            tr
              th Класс
              th Описание
          tbody
            tr
              td: code .alert.alert--success
              td Успех (зелёный)
            tr
              td: code .alert.alert--info
              td Информация (синий)
            tr
              td: code .alert.alert--error
              td Ошибка (красный)
            tr
              td: code .alert.alert--warning
              td Предупреждение (жёлтый)
            tr
              td: code .alert--flex
              td Модификатор: иконка + текст в строку

        .uk2-preview
          .alert.alert--success Успешно сохранено
          .alert.alert--info Это информационное сообщение
          .alert.alert--error Произошла ошибка, попробуйте снова
          .alert.alert--warning Внимание: данные не сохранены

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // Простые варианты
            .alert.alert--success Успешно сохранено
            .alert.alert--info Информационное сообщение
            .alert.alert--error Произошла ошибка
            .alert.alert--warning Внимание

            // С иконкой (модификатор flex)
            .alert.alert--success.alert--flex
              svg(xmlns='http://www.w3.org/2000/svg' ...)
              | Текст алерта с иконкой слева


      //- ══════════════════════════════════════════
      //- TIMING
      //- ══════════════════════════════════════════
      section#timing.uk2-section
        h2 Timing
        p.uk2-desc Метка с продолжительностью или временным значением. Подключается через #[code +timing(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data
              td string
              td Текст (HTML-строка)
            tr
              td: code props.mods
              td string[]
              td Модификаторы: #[code gray], #[code primary]

        .uk2-preview
          .uk2-row
            +timing('3 месяца')
            +timing('15 минут', {mods: ['gray']})
            +timing('6 недель', {mods: ['primary']})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/timing/index

            // Базовый
            +timing('3 месяца')

            // Серый
            +timing('15 минут', {mods: ['gray']})

            // Primary
            +timing('6 недель', {mods: ['primary']})

            // С HTML
            +timing('от &lt;b&gt;2 недель&lt;/b&gt;')


      //- ══════════════════════════════════════════
      //- AUTHOR
      //- ══════════════════════════════════════════
      section#author.uk2-section
        h2 Author
        p.uk2-desc Карточка автора: аватар или инициалы + имя + должность. Используется в кейсах, статьях, отзывах. Миксин: #[code +author(data, props)].

        table.uk2-params
          thead
            tr
              th Параметр
              th Тип
              th Описание
          tbody
            tr
              td: code data.src
              td string
              td Путь до фото. Если не указан — первая буква #[code data.title]
            tr
              td: code data.title
              td string
              td Имя
            tr
              td: code data.description
              td string
              td Должность или подпись
            tr
              td: code props.mods
              td string[]
              td Модификаторы блока

        .uk2-preview
          .uk2-row
            +author({src: 'assets/lunin.jpg', title: 'Анастасия', description: 'Руководитель проекта'})
            +author({title: 'Дмитрий Севальнев', description: 'Генеральный директор'})

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            // В mixins.pug подключено: include ../blocks/author/index

            // С фотографией
            +author({
              src: 'assets/photo.jpg',
              title: 'Анастасия',
              description: 'Руководитель проекта'
            })

            // Без фото — первая буква имени как аватар
            +author({
              title: 'Дмитрий Севальнев',
              description: 'Генеральный директор'
            })

            // С модификатором
            +author({title: 'Имя', description: 'Должность'}, {mods: ['small']})

      //- ══════════════════════════════════════════
      //- REVIEW-QUOTE
      //- ══════════════════════════════════════════
      section#review-quote.uk2-section
        h2 Review-quote
        p.uk2-desc Отзыв клиента: крупная цитата, автор (#[code +author]) и необязательный скан письма, который открывается в fancybox. Колонки 2:1 задаёт сам блок; на экране уже 992px скан уходит под цитату. Используется в детальной кейса.

        .uk2-preview
          include ../../blocks/review-quote/index

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/review-quote/index

            // Без скана — то же без ссылки .review-quote__scan


      //- ══════════════════════════════════════════
      //- TIMELINE
      //- ══════════════════════════════════════════
      section#timeline.uk2-section
        h2 Timeline
        p.uk2-desc Этапы работ: период, название, текст и необязательная промежуточная цифра (#[code .timeline__metric]). Вертикальный по умолчанию; #[code .timeline--row] — в ряд от 992px. Итоговый этап — #[code .timeline__item--result]. Цвет линии и заливки точки — переменные #[code --timeline-line] и #[code --timeline-dot-bg] у родителя. Используется в детальной кейса.

        .uk2-preview
          include ../../blocks/timeline/index

        .uk2-preview
          .timeline.timeline--row
            .timeline__item
              .timeline__date Июль 2025
              .timeline__title Аудит и семантика
              span.timeline__metric +12%
            .timeline__item
              .timeline__date Октябрь 2025
              .timeline__title Посадочные фильтров
              span.timeline__metric +40%
            .timeline__item.timeline__item--result
              .timeline__date Июль 2026
              .timeline__title Итог года
              span.timeline__metric ×2,7

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/timeline/index

            // В ряд от 992px
            .timeline.timeline--row


      //- ══════════════════════════════════════════
      //- STATEMENT
      //- ══════════════════════════════════════════
      section#statement.uk2-section
        h2 Statement
        p.uk2-desc Итог кейса одной фразой: крупный светлый текст с акцентами #[code &lt;b&gt;], фирменная линия слева. Метка — штатный #[code .pretitle], пояснение — #[code .statement__note]; обе необязательны. Внешних отступов нет. Используется в детальной кейса.

        .uk2-preview
          include ../../blocks/statement/index

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/statement/index

            // Без метки и пояснения — только .statement__text


      //- ══════════════════════════════════════════
      //- METRIC-CARD
      //- ══════════════════════════════════════════
      section#metric-card.uk2-section
        h2 Metric-card
        p.uk2-desc Карточка показателя: подпись, значение крупно, прежнее значение зачёркнутым (#[code .metric-card__was]) и пояснение под чертой (#[code .metric-card__note]); оба необязательны. Рост — утилита #[code -c-green] на значении. Высота на всю ячейку — карточки в ряду одной высоты; сетку задаёт место вставки (#[code d-grid]). Используется в детальной кейса.

        .uk2-preview
          div(style='max-width: 320px')
            include ../../blocks/metric-card/index

        .uk2-preview
          .d-grid.d-grid--sm-2.d-grid--lg-4.d-grid--gap-lg
            .metric-card
              .metric-card__label Органический трафик
              b.metric-card__value.-c-green ×2,7
              .metric-card__was было #[s 100%]
              .metric-card__note Сайт находят по моделям и характеристикам, а не по названию компании
            .metric-card
              .metric-card__label Стоимость заявки
              b.metric-card__value.-c-green 1 200 ₽
              .metric-card__was было #[s 2 900 ₽]
            .metric-card
              .metric-card__label Доля поиска в трафике
              b.metric-card__value 67,6%
              .metric-card__note Поиск стал основным каналом, реклама — дополнительным
            .metric-card
              .metric-card__label Запросов в топ-10
              b.metric-card__value 140

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/metric-card/index

            // Сетка — утилиты d-grid у обёртки
            .d-grid.d-grid--sm-2.d-grid--lg-4.d-grid--gap-lg
              .metric-card
                .metric-card__label Доля поиска в трафике
                b.metric-card__value 67,6%


      //- ══════════════════════════════════════════
      //- COMPARE-LINE
      //- ══════════════════════════════════════════
      section#compare-line.uk2-section
        h2 Compare-line
        p.uk2-desc Два значения на линии с плашкой разницы: «было → стало» по времени или канал против канала — вид один, смысл задают подписи (#[code .compare-line__label]). Левая точка нейтральная серая, правая — #[code .compare-line__point--accent]. Цвет значений — утилиты #[code -c-muted] и #[code -c-green]. Вывод #[code .compare-line__result] необязателен, внутри — штатный #[code text-icon] с иконкой #[code check-circle]. До 768px линия вертикальная и заканчивается у последней точки. Используется в детальной кейса.

        .uk2-preview(style='background: var(--color-gray--lighter)')
          .container.container--xl
            include ../../blocks/compare-line/index

        .uk2-preview(style='background: var(--color-gray--lighter)')
          //- Канал против канала, без вывода
          .container.container--xl
            .compare-line
              .compare-line__track
                .compare-line__point
                  .compare-line__label Контекстная реклама
                  span.compare-line__value.-c-muted ≈ 23 ₽
                  span.compare-line__note за посетителя
                .compare-line__badge в 15 раз дешевле
                .compare-line__point.compare-line__point--accent
                  .compare-line__label Поисковое продвижение
                  span.compare-line__value.-c-green 1,5 ₽
                  span.compare-line__note за посетителя

        details.uk2-details
          summary Код подключения
          pre.uk2-code.
            include ../blocks/compare-line/index

            // Канал против канала — те же элементы, другие подписи; без вывода — без .compare-line__result
            .compare-line
              .compare-line__track
                .compare-line__point
                  .compare-line__label Контекстная реклама
                  span.compare-line__value.-c-muted ≈ 23 ₽
                .compare-line__badge в 15 раз дешевле
                .compare-line__point.compare-line__point--accent
                  .compare-line__label Поисковое продвижение
                  span.compare-line__value.-c-green 1,5 ₽


      //- ══════════════════════════════════════════
      //- REPORT-CARD
      //- ══════════════════════════════════════════
      section#report-card.uk2-section
        h2 Report-card
        p.uk2-desc Итог кейса листом отчёта: слева колонка ключевых цифр на сером (значение крупно, рост — утилита #[code -c-green]), справа текст итога (абзацы и списки редактора в #[code .report-card__text]), внизу подпись — штатный #[code .author] — и приглушённый логотип. Колонка цифр и подпись необязательны: без цифр текст занимает всю ширину, без подписи логотип прижимается вправо — модификаторы не нужны. До 768px — одна колонка. Ширину задаёт место вставки (#[code container--xl]). Используется в детальной кейса.

        .uk2-preview(style='background: var(--color-gray--lighter)')
          include ../../blocks/report-card/index

        .uk2-preview(style='background: var(--color-gray--lighter)')
          //- Без цифр
          .report-card
            .report-card__body
              .report-card__text
