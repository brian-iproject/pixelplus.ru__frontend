    include ../../blocks/office-map/index

    .wide-block
        .page-container
            .h1.-tt-n Реквизиты
            .block-incut.block-incut--gray-lighter.block-incut--border-radius.block-incut--large-padding
                .tabs(data-filter="requisites")
                    button.tabs__item.-is-active(type="button", data-filter-source="requisites-0") Пиксель Промо
                    button.tabs__item(type="button", data-filter-source="requisites-1") Пиксель Плюс
                div.container.container--lg(data-filter-block="requisites")
                    div(data-filter-target="requisites-0")
                        +definition-list(requisitesPromo)
                    .-is-hidden(data-filter-target="requisites-1")
                        +definition-list(requisitesPlus)

    .wide-block
        .page-container
            include ../../blocks/contact-form/index
