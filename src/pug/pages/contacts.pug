        ];
        const requisitesPlus = [
            { term: 'ОГРН', value: '1107746371039' },
            { term: 'ИНН / КПП', value: '7715809321 / 773501001' },
            { term: 'Полное наименование', value: 'Общество с ограниченной ответственностью «Пиксель Плюс»' },
