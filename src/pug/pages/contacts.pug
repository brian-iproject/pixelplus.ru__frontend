    meta(name='description', content='')

block content
    -
        const requisitesPromo = [
            { term: 'ОГРН', value: '1107746955524' },
            { term: 'ИНН / КПП', value: '7735573603 / 773501001' },
            { term: 'Полное наименование', value: 'Общество с ограниченной ответственностью «Пиксель Промо»' },
            { term: 'Сокращенное наименование', value: 'ООО «Пиксель Промо»' },
            { term: 'ОКВЭД', value: 'SEO, контекстная реклама, маркетплейсы' },
            { term: 'Юр. адрес', value: '124498, Москва г, Зеленоград г, 4922-й проезд, дом № 4, строение 5' },
            { term: 'Почтовый адрес', value: '124498, Москва г, Зеленоград г, 4922-й проезд, дом № 4, строение 5' },
